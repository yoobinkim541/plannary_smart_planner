# Planary local and self-hosted deployment environment.
# Never commit .env or a Firebase service account key.

# Firebase Admin. Use either the full JSON key or the split fields below.
FIREBASE_PROJECT_ID=planary-a2f6b
FIREBASE_SERVICE_ACCOUNT_KEY=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Must be identical wherever the same saved e-Class credentials are read.
ECLASS_ENCRYPTION_KEY=

# Required by cron endpoints and GitHub Actions.
CRON_SECRET=

# Self-hosted Express API defaults.
# API_PORT=3000
# API_HOST=127.0.0.1
# ERROR_LOG_DIR=./logs
# HERMES_ERROR_WEBHOOK=

# Worker service account file alternative.
# FIREBASE_SERVICE_ACCOUNT_PATH=/opt/planary/app/worker/serviceAccount.json

# Worker intervals in milliseconds.
# WORKER_INTERVAL_MS=300000
# REMINDER_INTERVAL_MS=60000
# REQUEST_INTERVAL_MS=15000
# WIKI_OG_INTERVAL_MS=120000

# Only needed for the optional Supabase keep-alive cron.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
